<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.8 viene de serie en Windows 10/11: el .exe no necesita instalar nada.
    Las DLL de WebView2 van incrustadas dentro del .exe (se cargan desde recursos al arrancar).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HPlay-Receptor</AssemblyName>
    <RootNamespace>HPlayReceiver</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>HPlay Receptor</Product>
    <Copyright>GPL-3.0</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="WebView2Loader.dll" />
    <EmbeddedResource Include="..\shared\player.html" LogicalName="player.html" />
    <EmbeddedResource Include="..\shared\hls.js" LogicalName="hls.js" />
  </ItemGroup>
</Project>
